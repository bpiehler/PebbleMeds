{
  "name": "pebble-meds",
  "version": "1.0.5",
  "author": "Britt Piehler",
  "keywords": [
    "pebble-app"
  ],
  "scripts": {
    "test": "jest"
  },
  "main": "src/pkjs/app.js",
  "devDependencies": {
    "jest": "^29.0.0",
    "pngjs": "^7.0.0"
  },
  "jest": {
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "pebble": {
    "uuid": "d4e8a2f0-1b3c-4d5e-8f9a-0b1c2d3e4f5a",
    "displayName": "Pebble Meds",
    "companyName": "Britt Piehler",
    "versionLabel": "1.0.5",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "ConfigJson",
      "ChunkIndex",
      "ChunkTotal",
      "Action",
      "MedIndex",
      "DoseTs",
      "RequestSync"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_APP_ICON",
          "file": "images/app_icon.png",
          "menuIcon": true
        },
        {
          "type": "bitmap",
          "name": "IMAGE_ACTION_CHECK",
          "file": "images/action_bar_icon_check.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_ACTION_X",
          "file": "images/action_bar_icon_x.png"
        },
        {
          "type": "bitmap",
          "name": "IMAGE_ACTION_SNOOZE",
          "file": "images/action_bar_icon_snooze.png"
        },
        {
          "type": "raw",
          "name": "CONFIRMATION_ANIM",
          "file": "data/confirmation.pdc",
          "targetPlatforms": [
            "basalt",
            "chalk",
            "diorite",
            "emery",
            "flint",
            "gabbro"
          ]
        }
      ]
    },
    "capabilities": [
      "configurable",
      "timeline_enabled"
    ]
  }
}
